NODE_ENV=development
PORT=3001
API_PREFIX=v1
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nestjs
# Only for local prototyping. Use migrations everywhere else.
DB_SYNC=false
DB_LOGGING=false

# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string-32chars
JWT_EXPIRES_IN=1d
# Short-lived tokens for email verification / password reset
JWT_ACTION_EXPIRES_IN=1h

# console: print emails to the log (dev). smtp: send through SMTP.
MAIL_DRIVER=console
MAIL_FROM="Nestjs <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
